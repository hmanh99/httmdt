# Environment configuration
ENVIRONMENT=development
PROJECT_NAME="STRIDE Footwear"
VERSION="1.0.0"

# Database Configuration (PostgreSQL in Docker, or SQLite async fallback)
# Docker default:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stride_db
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./stride.db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stride_db

# Security & JWT Auth
SECRET_KEY=stride_super_secret_jwt_key_change_in_production_2026_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Superuser Admin
FIRST_SUPERUSER_EMAIL=admin@stride.com
FIRST_SUPERUSER_PASSWORD=Admin@123456
FIRST_SUPERUSER_NAME="System Admin"

# CORS Allowed Origins (JSON array or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Storage & Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Frontend environment
VITE_API_URL=http://localhost:8000/api/v1
