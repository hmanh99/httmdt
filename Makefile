.PHONY: help up down build logs migrate migration seed test test-cov clean dev-backend dev-frontend

help:
	@echo "Available commands:"
	@echo "  make up           - Start all services with Docker Compose"
	@echo "  make down         - Stop Docker Compose services"
	@echo "  make build        - Build Docker containers"
	@echo "  make logs         - Tail Docker Compose logs"
	@echo "  make migrate      - Run Alembic migrations to head"
	@echo "  make migration    - Create a new autogenerated Alembic migration (usage: make migration m='desc')"
	@echo "  make seed         - Seed database with realistic shoes and default admin"
	@echo "  make test         - Run backend pytest test suite"
	@echo "  make dev-backend  - Run FastAPI backend locally with uvicorn"
	@echo "  make dev-frontend - Run Vite React frontend locally"

up:
	docker-compose up -d

down:
	docker-compose down

build:
	docker-compose build

logs:
	docker-compose logs -f

migrate:
	cd backend && alembic upgrade head

migration:
	cd backend && alembic revision --autogenerate -m "$(m)"

seed:
	cd backend && python -m app.seed

test:
	pytest backend/tests -v

dev-backend:
	cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload

dev-frontend:
	cd frontend && npm run dev
